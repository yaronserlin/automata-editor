{
  "name": "automata-editor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A browser-based visual editor for designing, editing, and exporting finite automata diagrams.",
  "scripts": {
    "build:css": "tailwindcss -i ./css/tailwind.css -o ./css/tailwind.generated.css --minify",
    "watch:css": "tailwindcss -i ./css/tailwind.css -o ./css/tailwind.generated.css --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17",
    "vitest": "^5.0.0"
  }
}
